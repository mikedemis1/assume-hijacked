{"component": "executor",
 "description": "This branch's compose.yaml puts every service on one network, so every pair of services is an edge.",
 "db": {"role": "executor", "connection_limit": 3,
        "schemas": {"public": ["USAGE"]},
        "tables": {"accounts": ["SELECT"], "supply_points": ["SELECT"], "charges": ["SELECT"],
                   "flags": ["SELECT"], "register_sync": ["SELECT"], "approvals": ["SELECT"],
                   "credits": ["SELECT", "INSERT (request_id, account_id, amount_eur, evidence_ref)"],
                   "occupier_notices": ["SELECT", "INSERT (request_id, supply_point_id)"],
                   "disconnection_orders": ["SELECT", "INSERT (request_id, supply_point_id)"],
                   "events": ["SELECT", "INSERT (kind, detail)"],
                   "action_requests": ["SELECT", "UPDATE (status, decision_reason, decided_at)"],
                   "credits_id_seq": ["USAGE"], "occupier_notices_id_seq": ["USAGE"],
                   "disconnection_orders_id_seq": ["USAGE"], "events_id_seq": ["USAGE"]},
        "execute": ["pg_catalog.pg_advisory_lock(bigint)", "pg_catalog.pg_advisory_lock(int, int)",
                    "pg_catalog.pg_advisory_lock_shared(bigint)", "pg_catalog.pg_advisory_lock_shared(int, int)",
                    "pg_catalog.pg_try_advisory_lock(bigint)", "pg_catalog.pg_try_advisory_lock(int, int)",
                    "pg_catalog.pg_try_advisory_lock_shared(bigint)", "pg_catalog.pg_try_advisory_lock_shared(int, int)",
                    "pg_catalog.pg_advisory_xact_lock(bigint)", "pg_catalog.pg_advisory_xact_lock(int, int)",
                    "pg_catalog.pg_advisory_xact_lock_shared(bigint)", "pg_catalog.pg_advisory_xact_lock_shared(int, int)",
                    "pg_catalog.pg_try_advisory_xact_lock(bigint)", "pg_catalog.pg_try_advisory_xact_lock(int, int)",
                    "pg_catalog.pg_try_advisory_xact_lock_shared(bigint)", "pg_catalog.pg_try_advisory_xact_lock_shared(int, int)"]},
 "network": {"ingress_from": [],
             "egress_to": ["db", "tool-read-ticket", "tool-lookup-account", "tool-request-disconnection",
                           "tool-issue-bill-credit", "tool-set-temp-protection"],
             "dns": ["cluster"]},
 "k8s": {"service_account": "executor", "rbac": []},
 "azure": {"identity": "id-executor", "roles": [{"role": "Key Vault Secrets User", "scope": "kv-executor"}]},
 "runtime_class": "runc",
 "mcp": {"tools": []}}
