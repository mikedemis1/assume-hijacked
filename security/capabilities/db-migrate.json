    "egress_to": [
      "db",
      "internet"
    ],
    "dns": [
      "cluster",
      "login.microsoftonline.com",
      "vault.azure.net"
    ]
  },
  "k8s": {
    "service_account": "db-migrate",
    "network_names": ["db-migrate", "postgres-init"],
