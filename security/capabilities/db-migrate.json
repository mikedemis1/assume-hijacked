{
  "component": "db-migrate",
  "description": "Azure only. A Job that sets up the database server (the schema, once) and gives every workload database role a new password, stored in that workload's Key Vault (python -m app.dbsetup.passwords). It signs in to PostgreSQL as the Entra administrator of the server, so it has no password role of its own. It runs at install and at an explicit rotation, never on a plain upgrade.",
  "db": {
    "role": null,
    "execute": [],
    "tables": {}
  },
