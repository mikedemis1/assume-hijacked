{
  "component": "register-sync",
  "description": "Adds protection flags from the state register and marks the register fresh. It can never remove a flag.",
  "db": {
    "role": "register_sync",
    "login": true,
    "connection_limit": 5,
    "schemas": {
      "public": [
        "USAGE"
      ]
    },
    "tables": {},
    "execute": [
      "beat(text)",
      "sync_add_flag(text, text)",
      "sync_heartbeat()"
    ]
  },
  "network": {
    "ingress_from": [],
    "egress_to": [
      "db",
      "fake-register"
    ],
    "dns": [
      "cluster"
    ]
  },
  "k8s": {
    "service_account": "register-sync",
    "rbac": []
  },
  "azure": {
    "identity": "id-register-sync",
    "roles": [
      {
        "role": "Key Vault Secrets User",
        "scope": "kv-register-sync"
      }
    ]
  },
  "runtime_class": "runc",
  "mcp": {
    "tools": []
  }
}
