{
  "component": "db",
  "description": "The database itself: the roles that own the SECURITY DEFINER functions (no login), what PUBLIC holds, and row-level security. The db is also on hostaccess, the one network with a route out, so the host can reach its port.",
  "db": {
    "role": null,
    "roles": [
      {
        "role": "postgres",
        "bootstrap_superuser": true,
        "default_privileges": [
          "ON FUNCTIONS REVOKE EXECUTE FROM PUBLIC"
        ]
      },
      {
        "role": "api_owner",
        "login": false,
        "schemas": {
          "public": [
            "USAGE"
          ]
        },
        "tables": {
          "accounts": [
            "SELECT (customer_id, id, status, supply_point_id, tariff)"
          ],
          "action_requests": [
            "INSERT (account_id, amount_eur, evidence_ref, kind, move_out_date, reason, ticket_id)",
            "SELECT (created_at, id, kind, ticket_id)"
          ],
          "action_requests_id_seq": [
            "USAGE"
          ],
          "customers": [
            "SELECT (id, name)"
          ],
          "events": [
            "INSERT (actor, detail, kind)"
          ],
          "events_id_seq": [
            "USAGE"
          ],
          "flags": [
            "INSERT (source, supply_point_id)",
            "SELECT (supply_point_id)"
          ],
          "leases": [
            "SELECT (allowed_tools, bound_pod, created_at, expires_at, revoked, ticket_id, token_hash)",
            "UPDATE (revoked)"
          ],
          "supply_points": [
            "SELECT (address, id)"
          ],
          "tickets": [
            "SELECT (body, customer_id, id)"
          ],
          "tool_calls": [
            "SELECT (lease_hash, outcome, tool)"
          ]
        },
        "execute": [
          "pg_catalog.pg_advisory_lock(bigint)",
          "pg_catalog.pg_advisory_lock(int, int)",
          "pg_catalog.pg_advisory_lock_shared(bigint)",
          "pg_catalog.pg_advisory_lock_shared(int, int)",
          "pg_catalog.pg_try_advisory_lock(bigint)",
          "pg_catalog.pg_try_advisory_lock(int, int)",
          "pg_catalog.pg_try_advisory_lock_shared(bigint)",
          "pg_catalog.pg_try_advisory_lock_shared(int, int)",
          "pg_catalog.pg_advisory_xact_lock(bigint)",
          "pg_catalog.pg_advisory_xact_lock(int, int)",
          "pg_catalog.pg_advisory_xact_lock_shared(bigint)",
          "pg_catalog.pg_advisory_xact_lock_shared(int, int)",
          "pg_catalog.pg_try_advisory_xact_lock(bigint)",
          "pg_catalog.pg_try_advisory_xact_lock(int, int)",
          "pg_catalog.pg_try_advisory_xact_lock_shared(bigint)",
          "pg_catalog.pg_try_advisory_xact_lock_shared(int, int)"
        ],
        "owns": [
          "FUNCTION api_lookup_account(text) SECURITY DEFINER",
          "FUNCTION api_read_ticket(text) SECURITY DEFINER",
          "FUNCTION api_request_credit(text, numeric, text, integer) SECURITY DEFINER",
          "FUNCTION api_request_moveout(text, date) SECURITY DEFINER",
          "FUNCTION api_set_temp_protection(text) SECURITY DEFINER",
          "FUNCTION lease_ticket_for_tool(text, text)",
          "FUNCTION reply_facts(text) SECURITY DEFINER",
          "FUNCTION finish_reply_facts(text, text) SECURITY DEFINER"
        ],
        "default_privileges": [
          "ON FUNCTIONS REVOKE EXECUTE FROM PUBLIC"
        ]
      },
