# PostgreSQL flexible server: B1ms, version 17, no public access, reachable only through a
# private endpoint in snet-pe (decision 2). Password and Entra authentication are both on:
#   - Entra: humans and the db-migrate Job. The Entra administrator is the db-migrate
#     workload identity, so the schema migration needs no password at all.
#   - Password: one per workload role (decision 3), read by each pod from its own Key Vault.
#
# Secrets and the Terraform state
# -------------------------------
# ci-plan (any branch) can read every state file, so no password may be in the state.
#   1. The admin password is generated by an EPHEMERAL random_password and sent through the
#      write-only argument administrator_password_wo (azurerm 4.81.0 schema: write_only).
#      Neither the plan nor the state keeps it. Nobody knows it afterwards: it is a break-glass
#      login that can be reset through ARM (`az postgres flexible-server update
#      --admin-password`) by someone with rights on rg-lab. Day-to-day admin is Entra.
#      Bump postgres_admin_password_version to rotate it.
#   2. The per-role workload passwords are NOT created by Terraform. azurerm_key_vault_secret
#      has value_wo (checked, 4.81.0), but writing a secret is a vault DATA-plane call: the
#      vaults deny every network except the two AKS subnets (infra/base network_acls, bypass
#      None), and ci-apply runs on GitLab runners outside them. The lab state would also own
#      the secrets, so each nightly destroy would delete them. They are generated inside the
#      cluster instead (db-migrate holds Key Vault Secrets Officer on the vaults in its
#      manifest) or seeded once by the owner from an allowed IP. See the C3 report.

locals {
  # Server names are global DNS names (<name>.postgres.database.azure.com): readable prefix
  # plus a short hash of the subscription, like the vault names in infra/base.
  postgres_server_name = "psql-ah-${substr(sha256(var.subscription_id), 0, 8)}"
  db_admin             = module.workload_identity[var.db_admin_component]
}

ephemeral "random_password" "postgres_admin" {
  length      = 32
  special     = true
  min_upper   = 2
  min_lower   = 2
  min_numeric = 2
  min_special = 2
  # Characters that survive shell, URL and connection-string quoting.
  override_special = "-_.~"
}

resource "azurerm_postgresql_flexible_server" "this" {
  name                = local.postgres_server_name
  resource_group_name = data.azurerm_resource_group.lab.name
  location            = var.location

  version      = "17"
  sku_name     = "B_Standard_B1ms"
  storage_mb   = 32768
  storage_tier = "P4"

  backup_retention_days        = 7
  geo_redundant_backup_enabled = false
  auto_grow_enabled            = false

  public_network_access_enabled = false

  administrator_login               = var.postgres_admin_login
  administrator_password_wo         = ephemeral.random_password.postgres_admin.result
  administrator_password_wo_version = var.postgres_admin_password_version

  authentication {
    active_directory_auth_enabled = true
    password_auth_enabled         = true
    tenant_id                     = var.tenant_id
  }

  tags = var.tags

  lifecycle {
    # Azure picks the zone when none is given and may move it on failover.
    ignore_changes = [zone]
  }
}

resource "azurerm_postgresql_flexible_server_active_directory_administrator" "db_migrate" {
  server_name         = azurerm_postgresql_flexible_server.this.name
  resource_group_name = data.azurerm_resource_group.lab.name
  tenant_id           = var.tenant_id
  object_id           = local.db_admin.principal_id
  principal_name      = local.db_admin.name
  principal_type      = "ServicePrincipal"
}

# The chart's db-migrate Job connects to `supplier` before init runs, so the database must
# exist on the server already.
resource "azurerm_postgresql_flexible_server_database" "supplier" {
  name      = "supplier"
  server_id = azurerm_postgresql_flexible_server.this.id
  charset   = "UTF8"
  collation = "en_US.utf8"
}

resource "azurerm_private_endpoint" "postgres" {
  name                = "pe-${local.postgres_server_name}"
  resource_group_name = data.azurerm_resource_group.lab.name
  location            = var.location
  subnet_id           = local.net.spoke_subnet_ids["snet-pe"]

  private_service_connection {
    name                           = "psc-postgres"
    private_connection_resource_id = azurerm_postgresql_flexible_server.this.id
    subresource_names              = ["postgresqlServer"]
    is_manual_connection           = false
  }

  # The server's public name resolves to the private IP for every VNet linked to this zone
  # (infra/net links it to hub and spoke).
  private_dns_zone_group {
    name                 = "postgres"
    private_dns_zone_ids = [local.net.private_dns_zone_ids["postgres"]]
  }

  tags = var.tags
}
