# Copy to terraform.tfvars (git-ignored) and fill in. Nothing here is a secret, but the IDs,
# the IP and the address identify the owner, so they stay out of the repo.

subscription_id = "00000000-0000-0000-0000-000000000000"
tenant_id       = "00000000-0000-0000-0000-000000000000"

# infra/base output state_storage_account_name. The lab reads the base state there.
state_storage_account_name = "stahstateexample01"

# Who may reach the Kubernetes API.
api_authorized_ip_ranges = ["203.0.113.10/32"]

# Entra group(s) with cluster-admin (local accounts are disabled).
# aks_admin_group_object_ids = ["00000000-0000-0000-0000-000000000000"]

# Log Analytics alerts go here.
alert_email = "owner@example.com"

# 0 parks the Kata pool when no agent or tool needs to run.
sandbox_node_count = 1

# Default: <repo>/permissions
# capabilities_dir = "../../permissions"
