{
  "component": "console",
  "description": "Staff approvals, resuming the agents after the kill switch, and operational status. Browser sessions validate Entra object ids and app roles; the database accepts an approval or a resume only for an active member of its staff list.",
  "db": {
    "role": "approver",
    "login": true,
    "connection_limit": 5,
    "schemas": {
      "public": [
        "USAGE"
      ]
    },
    "tables": {
      "action_requests": [
        "SELECT",
        "UPDATE (decided_at, decision_reason, status)"
      ],
      "events": [
        "INSERT (detail, kind)",
        "SELECT (actor, created_at, id, kind)"
      ],
      "events_id_seq": [
        "USAGE"
      ],
      "risk_assessments": [
        "SELECT"
      ],
      "heartbeats": [
        "SELECT (component, last_beat)"
      ],
      "agent_control": [
        "SELECT (paused)"
      ]
    },
    "execute": [
      "approve_request(int, uuid)",
      "required_approvals(text)",
      "resume_agents(uuid)"
    ]
  },
  "network": {
    "ingress_from": [
      "internet"
    ],
    "egress_to": [
      "db",
      "internet"
    ],
    "dns": [
      "cluster",
      "login.microsoftonline.com"
    ]
  },
  "k8s": {
    "service_account": "console",
    "rbac": []
  },
  "azure": {
    "identity": "id-console",
    "roles": [
      {
        "role": "Key Vault Secrets User",
        "scope": "kv-console"
      }
    ]
  },
  "runtime_class": "runc",
  "mcp": {
    "tools": []
  }
}
