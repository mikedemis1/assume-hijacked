# Keep secrets and local files out of the build context and the images.
.env
.env.*
# Hidden files and folders (.git, .venv, caches, editor and tool folders) and Markdown
# docs: the images need none of them.
.*
*.md
context
wheels
tests/*
# the attack-suite image (tests/attacks/Dockerfile) is built from this one folder
!tests/attacks
*.egg-info
*.pem
__pycache__
reports
