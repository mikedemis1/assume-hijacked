{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "assume-hijacked chart values",
  "type": "object",
  "required": ["env", "registry", "images", "sandbox", "console", "llm", "db"],
  "definitions": {
    "pinnedImage": {
      "description": "An image by digest: name[:tag]@sha256:<64 hex>. A tag alone can be moved to other content.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/:-]*@sha256:[a-f0-9]{64}$"
    },
    "empty": {"type": "string", "maxLength": 0}
  },
  "properties": {
    "env": {"enum": ["kind", "azure"]},
    "registry": {
      "description": "Registry prefix the admission policy accepts images from, ending in '/'.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.:-]*/$"
    },
    "images": {
      "type": "object",
      "required": ["app", "postgres"],
      "additionalProperties": {"$ref": "#/definitions/pinnedImage"}
    },
    "sandbox": {
      "type": "object",
      "required": ["runtimeClass"],
      "properties": {"runtimeClass": {"type": "string", "minLength": 1}}
    },
    "console": {
      "type": "object",
      "required": ["authMode"],
      "properties": {
        "authMode": {"enum": ["entra", "dev"]},
        "redirectUri": {"type": "string"},
        "devUsers": {"type": "string"}
      }
    },
    "llm": {
      "type": "object",
      "required": ["backend", "model", "tokenBudgetPerLease"],
      "properties": {
        "backend": {"enum": ["scripted", "anthropic"]},
        "model": {"type": "string", "minLength": 1},
        "tokenBudgetPerLease": {"type": "integer", "minimum": 1}
      }
    },
    "db": {
      "type": "object",
      "required": ["host", "port", "name"],
      "properties": {
        "port": {"type": "integer"}
      }
    },
    "network": {
      "type": "object",
      "properties": {"databaseCidr": {"type": "string"}}
    },
    "attackSuite": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "databaseAddress": {"type": "string", "pattern": "^$|^[0-9]{1,3}(\\.[0-9]{1,3}){3}$"},
        "image": {"anyOf": [{"$ref": "#/definitions/empty"}, {"$ref": "#/definitions/pinnedImage"}]}
      },
      "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
      "then": {"required": ["image"], "properties": {"image": {"$ref": "#/definitions/pinnedImage"}}}
    },
    "dbPasswords": {
      "type": "object",
      "properties": {
        "rotationJob": {"type": "boolean"},
        "rotationJobName": {"type": "string", "pattern": "^$|^db-passwords-rotate-[0-9]{14}$"}
      }
    },
    "stubs": {
      "description": "kind only, temporary: components that run the ops stand-in instead of their entry point.",
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["tool-read-ticket", "tool-lookup-account", "tool-request-disconnection",
                         "tool-issue-bill-credit", "tool-set-temp-protection", "tool-gateway",
                         "risk-engine", "dispatcher", "llm-gateway", "executor",
                         "console"]}
    },
    "secrets": {
      "type": "object",
      "properties": {
        "dbPasswords": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    }
  },
  "allOf": [
    {
      "description": "Azure: Entra sign-in only. Dev auth trusts a header and must never reach a real cluster.",
      "if": {"properties": {"env": {"const": "azure"}}, "required": ["env"]},
      "then": {"properties": {"console": {"properties": {"authMode": {"const": "entra"}}}}}
    },
    {
      "description": "Azure: no secret material in values; every secret comes from Key Vault.",
      "if": {"properties": {"env": {"const": "azure"}}, "required": ["env"]},
      "then": {
        "properties": {
          "secrets": {
            "properties": {
              "postgresPassword": {"$ref": "#/definitions/empty"},
              "gatewaySigningKeyPem": {"$ref": "#/definitions/empty"},
              "anthropicApiKey": {"$ref": "#/definitions/empty"},
              "consoleClientSecret": {"$ref": "#/definitions/empty"},
              "dbPasswords": {"maxProperties": 0}
            }
          }
        }
      }
    },
    {
      "description": "Azure: every component runs its own code; the ops stand-in is for kind only.",
      "if": {"properties": {"env": {"const": "azure"}}, "required": ["env"]},
      "then": {"properties": {"stubs": {"maxItems": 0}}}
    },
    {
      "description": "Azure: db-migrate needs the Azure CLI image for its Entra token.",
      "if": {"properties": {"env": {"const": "azure"}}, "required": ["env"]},
      "then": {"properties": {"images": {"required": ["azureCli"]}}}
    },
    {
      "description": "kind: images come from the local registry container (a local build has no registry digest).",
      "if": {"properties": {"env": {"const": "kind"}}, "required": ["env"]},
      "then": {"properties": {"registry": {"const": "localhost:5001/"}}}
    },
    {
      "description": "Azure: images come from the ACR login server only.",
      "if": {"properties": {"env": {"const": "azure"}}, "required": ["env"]},
      "then": {"properties": {"registry": {"pattern": "^[a-z0-9]{5,50}\\.azurecr\\.io/$"}}}
    },
    {
      "description": "Azure: sandboxed pods run under the AKS Pod Sandboxing (Kata) class and nothing else (https://learn.microsoft.com/en-us/azure/aks/use-pod-sandboxing).",
      "if": {"properties": {"env": {"const": "azure"}}, "required": ["env"]},
      "then": {"properties": {"sandbox": {"properties": {"runtimeClass": {"const": "kata-vm-isolation"}}}}}
    },
    {
      "description": "Azure: the database is outside the cluster, so its NetworkPolicy edges need the private endpoint subnet, and nothing wider.",
      "if": {"properties": {"env": {"const": "azure"}}, "required": ["env"]},
      "then": {
        "required": ["network"],
        "properties": {
          "network": {
            "required": ["databaseCidr"],
            "properties": {
              "databaseCidr": {
                "description": "A private (RFC 1918) range of /24 or longer (the template checks the same: ah.privateCidrPattern).",
                "pattern": "^(10\\.[0-9]{1,3}|172\\.(1[6-9]|2[0-9]|3[01])|192\\.168)\\.[0-9]{1,3}\\.[0-9]{1,3}/(2[4-9]|3[0-2])$"
              }
            }
          }
        }
      }
    }
  ]
}
