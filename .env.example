# Copy to .env and change the values. Local development only; all data is fake.
POSTGRES_PASSWORD=change-me-admin
DB_PASSWORD_TOOL_READ_TICKET=change-me-tool-read-ticket
DB_PASSWORD_TOOL_LOOKUP_ACCOUNT=change-me-tool-lookup-account
DB_PASSWORD_TOOL_REQUEST_DISCONNECTION=change-me-tool-request-disconnection
DB_PASSWORD_TOOL_ISSUE_BILL_CREDIT=change-me-tool-issue-bill-credit
DB_PASSWORD_TOOL_SET_TEMP_PROTECTION=change-me-tool-set-temp-protection
DB_PASSWORD_EXECUTOR=change-me-executor
DB_PASSWORD_APPROVER=change-me-approver
VULNERABLE=false
# Change to 5433 if another PostgreSQL already uses 5432 on this PC.
DB_PORT=5432
# The tests TRUNCATE every table, so they run in their own database, never the stack's.
# Default supplier_test (created by db/init/init.sh); the suite refuses to use "supplier".
# TEST_DB_NAME=supplier_test
# Only if your network intercepts HTTPS (antivirus scanning, corporate proxy) and
# the image build fails with a certificate error: path to the CA bundle (PEM).
# PIP_CERT_FILE=
# Only if pip cannot download a package's index page (some HTTPS scanners break
# large responses): folder with that package's .whl file, e.g. ./wheels
# (name and version must be in requirements.lock; the lock's hashes are checked)
# LOCAL_WHEELS_DIR=
